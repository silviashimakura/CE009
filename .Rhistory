============================================================
set.seed(2026)
# survival é pacote "recommended", normalmente já vem com o R base.
# Se necessário: install.packages("survival")
library(survival)
library(dplyr)   # manipulação de dados (install.packages("dplyr") se preciso)
simulate_cohort <- function(n,
lambda0     = 1/1500,  # hazard basal (eventos/pessoa-dia)
HR_vac      = 1.0,      # HR VERDADEIRO do esquema completo
beta_sex    = log(1.0),   # log-HR sexo (1 = masc., ref = fem.)
beta_age    = log(1.02),  # log-HR por ano de idade (centrada)
beta_hiv    = log(1.8),   # log-HR HIV não controlado vs. controlado
beta_prev   = log(0.7),   # log-HR infecção prévia (proxy de imunidade)
p_hiv_unctrl = 0.30,
p_sex_male   = 0.55,
p_prev_inf   = 0.15,
age_mean     = 45, age_sd = 12,
# --- distribuição do atraso até completar o esquema ---
vac_shape   = 1.5,     # forma da Weibull do atraso (T_vac)
vac_scale   = 90,       # escala (dias) da Weibull do atraso
p_never_vac = 0.20,     # proporção que NUNCA completa o esquema
# --- censura administrativa e perda de seguimento ---
admin_end   = 950,      # duração do estudo em dias (mai/2021-dez/2023 ~ 975d)
loss_rate   = 1/2000     # taxa (constante) de perda de seguimento
) {
# --- covariáveis basais (fixas, medidas em T0) ---
sex      <- rbinom(n, 1, p_sex_male)
age      <- rnorm(n, age_mean, age_sd)
age_c    <- age - age_mean                # idade centrada, para interpretar beta_age em torno da média
hiv_unc  <- rbinom(n, 1, p_hiv_unctrl)
prev_inf <- rbinom(n, 1, p_prev_inf)
lp <- beta_sex * sex + beta_age * age_c + beta_hiv * hiv_unc + beta_prev * prev_inf
h0 <- lambda0 * exp(lp)                    # hazard basal individual (antes da exposição)
# --- tempo até completar o esquema vacinal (T_vac) ---
never_vac <- rbinom(n, 1, p_never_vac) == 1
T_vac <- rweibull(n, shape = vac_shape, scale = vac_scale)
T_vac[never_vac] <- Inf
# --- simulação do tempo até o evento, hazard exponencial por partes ---
E <- rexp(n, rate = 1)                     # "energia" de risco acumulado, E ~ Exp(1)
H_at_Tvac <- h0 * T_vac                    # risco acumulado até T_vac (pode ser Inf)
T_event <- ifelse(
E <= H_at_Tvac,
E / h0,                                                   # evento ocorre ANTES de completar o esquema
T_vac + (E - H_at_Tvac) / (h0 * HR_vac)                   # evento ocorre DEPOIS (sob risco já modificado)
)
# obs.: quando T_vac = Inf, H_at_Tvac = Inf, então sempre cai no primeiro ramo -> correto.
# --- censura administrativa + perda de seguimento aleatória ---
C_loss  <- rexp(n, rate = loss_rate)
time_obs <- pmin(T_event, admin_end, C_loss)
status   <- as.integer(T_event <= admin_end & T_event <= C_loss)
data.frame(
id = 1:n, sex, age, hiv_unc, prev_inf,
T_vac, time_obs, status
)
}
## 2a. Dataset NAIVE (uma linha por indivíduo, exposição fixa em T0)
## -> reproduz o viés: quem completou o esquema em QUALQUER momento
##    do seguimento é classificado como "exposto" desde o início.
build_naive <- function(coh) {
coh %>%
mutate(vac_naive = as.integer(is.finite(T_vac))) %>%
select(id, time = time_obs, status, vac = vac_naive,
sex, age, hiv_unc, prev_inf)
}
## 2b. Dataset TEMPO-DEPENDENTE em formato "long" (start, stop, status)
## -> cada indivíduo contribui 1 linha (se nunca vacinado/no seguimento)
##    ou 2 linhas (não-exposto até T_vac; exposto de T_vac até o fim).
build_longformat <- function(coh) {
# linha 1: período não-exposto, de 0 até min(T_vac, time_obs)
seg1 <- coh %>%
mutate(
tstart = 0,
tstop  = pmin(T_vac, time_obs),
vac    = 0L,
status_seg = ifelse(T_vac >= time_obs, status, 0L)  # só "conta" evento se ocorreu antes de vacinar
) %>%
filter(tstop > tstart) %>%                              # remove linhas degeneradas (tstart==tstop)
select(id, tstart, tstop, status = status_seg, vac, sex, age, hiv_unc, prev_inf)
# linha 2: período exposto, apenas para quem completou o esquema DENTRO do seguimento
seg2 <- coh %>%
filter(T_vac < time_obs) %>%
mutate(
tstart = T_vac,
tstop  = time_obs,
vac    = 1L,
status_seg = status
) %>%
select(id, tstart, tstop, status = status_seg, vac, sex, age, hiv_unc, prev_inf)
bind_rows(seg1, seg2) %>% arrange(id, tstart)
}
## 2c. Dataset LANDMARK (marco em L dias)
## -> inclui só quem estava em risco (sem evento/censura) em L;
##    classifica exposição pelo status EM L; reinicia o tempo em L.
build_landmark <- function(coh, L) {
coh %>%
filter(time_obs >= L) %>%                 # precisa estar "vivo" (em risco) no marco L
mutate(
vac_L  = as.integer(T_vac <= L),
time_L = time_obs - L,
status_L = status
) %>%
select(id, time = time_L, status = status_L, vac = vac_L,
sex, age, hiv_unc, prev_inf)
}
run_one_replication <- function(n, HR_vac, landmark_L = 90, ...) {
coh <- simulate_cohort(n = n, HR_vac = HR_vac, ...)
dat_naive <- build_naive(coh)
dat_long  <- build_longformat(coh)
dat_lm    <- build_landmark(coh, L = landmark_L)
fit_naive <- coxph(Surv(time, status) ~ vac + sex + age + hiv_unc + prev_inf,
data = dat_naive)
fit_td    <- coxph(Surv(tstart, tstop, status) ~ vac + sex + age + hiv_unc + prev_inf,
data = dat_long, cluster = id)
fit_lm    <- coxph(Surv(time, status) ~ vac + sex + age + hiv_unc + prev_inf,
data = dat_lm)
extract <- function(fit) {
s <- summary(fit)$coefficients
c(logHR = s["vac", "coef"], se = s["vac", "se(coef)"])
}
data.frame(
metodo = c("naive", "cox_td", "landmark"),
rbind(extract(fit_naive), extract(fit_td), extract(fit_lm)),
n_landmark = nrow(dat_lm)
)
}
cenarios <- expand.grid(
HR_vac    = c(1.0, 0.7, 0.4),
atraso    = c("curto", "longo"),
stringsAsFactors = FALSE
)
# parâmetros da Weibull do atraso para cada cenário de "atraso"
params_atraso <- list(
curto = list(vac_shape = 2.0, vac_scale = 35),   # atraso menor e mais concentrado
longo = list(vac_shape = 1.2, vac_scale = 120)   # atraso maior e mais disperso
)
n_sim <- 1000        # nº de replicações por cenário (ajustar conforme tempo computacional)
n_ind <- 1500        # tamanho da coorte simulada (ajustar para o N real do TCC)
resultados <- list()
k <- 1
for (i in seq_len(nrow(cenarios))) {
hr_true   <- cenarios$HR_vac[i]
par_atr   <- params_atraso[[cenarios$atraso[i]]]
cat(sprintf("Cenário %d/%d: HR=%.1f, atraso=%s\n",
i, nrow(cenarios), hr_true, cenarios$atraso[i]))
for (r in seq_len(n_sim)) {
rep_res <- tryCatch(
run_one_replication(
n = n_ind, HR_vac = hr_true, landmark_L = 90,
vac_shape = par_atr$vac_shape, vac_scale = par_atr$vac_scale
),
error = function(e) NULL
)
if (!is.null(rep_res)) {
rep_res$rep       <- r
rep_res$cenario_HR    <- hr_true
rep_res$cenario_atraso <- cenarios$atraso[i]
resultados[[k]] <- rep_res
k <- k + 1
}
}
}
res_df <- bind_rows(resultados)
resumo <- res_df %>%
mutate(
logHR_true = log(cenario_HR),
lower = logHR - 1.96 * se,
upper = logHR + 1.96 * se,
cobre = as.integer(logHR_true >= lower & logHR_true <= upper),
rejeita_H0 = as.integer(lower > 0 | upper < 0)   # rejeita HR=1 ao nível de 5%
) %>%
group_by(cenario_HR, cenario_atraso, metodo) %>%
summarise(
n_reps        = n(),
HR_true       = first(cenario_HR),
vies_logHR    = mean(logHR - logHR_true),
HR_medio_est  = exp(mean(logHR)),
EQM_logHR     = mean((logHR - logHR_true)^2),
cobertura_IC95 = mean(cobre),
# se HR_true == 1: esta coluna é a taxa de erro tipo I;
# se HR_true  < 1: esta coluna é o poder estatístico
rejeicao_H0   = mean(rejeita_H0),
.groups = "drop"
) %>%
arrange(cenario_atraso, cenario_HR, metodo)
print(resumo, n = Inf)
## ------------------------------------------------------------
## 6. (Opcional) Visualização: viés de log(HR) por método e cenário
## ------------------------------------------------------------
library(ggplot2)
ggplot(resumo, aes(x = metodo, y = vies_logHR, fill = metodo)) +
geom_col() +
facet_grid(cenario_atraso ~ cenario_HR,
labeller = label_both) +
geom_hline(yintercept = 0, linetype = "dashed") +
labs(y = "Viés médio de log(HR)", x = NULL,
title = "Viés de tempo imortal: naive vs. Cox tempo-dependente vs. landmark") +
theme_minimal()
(1.75+1.9)/2
